# Copiez ce fichier en .env pour le développement local.
# Sur Netlify, créez ces variables dans : Site configuration > Environment variables.

# Base PostgreSQL (Neon recommandé). Exemple :
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Avec Netlify DB, NETLIFY_DATABASE_URL est utilisée automatiquement si DATABASE_URL est vide.
DATABASE_URL=

# OBLIGATOIRES : mot de passe admin et clé de signature des sessions (longue chaîne aléatoire)
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optionnel : e-mail de l'administrateur (par défaut : keitabenzoumana@gmail.com)
ADMIN_EMAIL=keitabenzoumana@gmail.com

# Optionnel : forcer les cookies HTTPS (true/false). Par défaut : actif en production.
# COOKIE_SECURE=false   # à utiliser seulement pour tester `npm run start` en HTTP local
